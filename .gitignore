# Build and tool output
/result
/result-*
/.direnv/
/.envrc
/.pre-commit-config.yaml
__pycache__/
*.py[cod]
**/.terraform/
**/.build/

# Plaintext that must never be committed
.env
.env.*
*.backup
*.tfstate
*.tfstate.*
# OpenTofu encrypts these itself (encryption.tf); they are committed.
!/components/homelab/providers/*/terraform.tfstate
*.tfvars
*.tfvars.json
/deployments/homelab/**/*.agekey
/deployments/homelab/**/admin.conf
/deployments/homelab/**/kubeconfig
/secrets/*.hash
/secrets/*.key
/secrets/*.pem
/secrets/mail-aws-vpn.conf
