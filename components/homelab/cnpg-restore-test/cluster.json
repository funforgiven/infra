{
  "apiVersion": "postgresql.cnpg.io/v1",
  "kind": "Cluster",
  "metadata": {"name": "restore"},
  "spec": {
    "instances": 1,
    "imageName": "ghcr.io/cloudnative-pg/postgresql:18.4-standard-trixie@sha256:f0cc49632b5cc1e51f65ba03658c89bd31d64ea2672b14843a808a8d281417e1",
    "bootstrap": {"recovery": {"source": "source"}},
    "externalClusters": [
      {
        "name": "source",
        "plugin": {
          "name": "barman-cloud.cloudnative-pg.io",
          "parameters": {"barmanObjectName": "source", "serverName": "set by run.sh"}
        }
      }
    ],
    "storage": {"storageClass": "ceph-block-restore", "size": "set by run.sh"},
    "resources": {
      "requests": {"cpu": "100m", "memory": "256Mi"},
      "limits": {"memory": "1Gi"}
    }
  }
}
