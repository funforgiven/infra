@@ -0,0 +1,19 @@
+// Local regression for the dedicated backend's network boundary.
+package artifactcache
+
+import (
+	"net"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAvailabilityStandaloneBackendBindsLoopback(t *testing.T) {
+	h, err := StartLoopbackHandler(t.TempDir(), "127.0.0.1", 0, "fixture-secret", nil)
+	require.NoError(t, err)
+	defer h.Close()
+	address := h.(*handler).listener.Addr().(*net.TCPAddr)
+	require.True(t, address.IP.IsLoopback())
+	require.Equal(t, "127.0.0.1", address.IP.String())
+	require.NotZero(t, address.Port)
+}
