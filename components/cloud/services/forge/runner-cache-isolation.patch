+// Local availability regressions for the pinned Forgejo Runner cache backend.
+package artifactcache
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/julienschmidt/httprouter"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+	"github.com/timshannon/bolthold"
+)
+
+func TestAvailabilityGCKeepsRepositoryAndPullRequestScopes(t *testing.T) {
+	raw, err := newCaches(t.TempDir(), "fixture-secret", logrus.New())
+	require.NoError(t, err)
+	c := raw.(*cachesImpl)
+	defer c.close()
+	now := time.Now()
+	rows := []*Cache{
+		{Repo: "owner/a", WriteIsolationKey: "", CreatedAt: now.Add(-6 * time.Hour).Unix()},
+		{Repo: "owner/a", WriteIsolationKey: "", CreatedAt: now.Add(-5 * time.Hour).Unix()},
+		{Repo: "owner/a", WriteIsolationKey: "refs/pull/1/head", CreatedAt: now.Add(-4 * time.Hour).Unix()},
+		{Repo: "owner/a", WriteIsolationKey: "refs/pull/1/head", CreatedAt: now.Add(-3 * time.Hour).Unix()},
+		{Repo: "owner/a", WriteIsolationKey: "refs/pull/2/head", CreatedAt: now.Add(-2 * time.Hour).Unix()},
+		{Repo: "owner/b", WriteIsolationKey: "", CreatedAt: now.Add(-time.Hour).Unix()},
+	}
+	for _, row := range rows {
+		row.Key, row.Version, row.Complete = "same-cache-key", "same-version", true
+		row.UsedAt, row.Size = now.Add(-10*time.Minute).Unix(), 7
+		require.NoError(t, insertCache(c.db, row))
+		path := c.storage.filename(row.ID)
+		require.NoError(t, os.MkdirAll(filepath.Dir(path), 0o700))
+		require.NoError(t, os.WriteFile(path, []byte("fixture"), 0o600))
+	}
+	c.setgcAt(now.Add(-2 * time.Hour))
+	c.gcCache()
+	for i, row := range rows {
+		cached, err := c.readCache(row.ID, row.Repo)
+		_, fileErr := os.Stat(c.storage.filename(row.ID))
+		if i == 0 || i == 2 {
+			require.True(t, errors.Is(err, bolthold.ErrNotFound), "superseded entry %d should be collected", i)
+			require.True(t, os.IsNotExist(fileErr))
+		} else {
+			require.NoError(t, err, "another repository or PR must not evict scope %d", i)
+			require.Equal(t, row.ID, cached.ID)
+			require.NoError(t, fileErr)
+		}
+	}
+	ownPR, err := findCacheWithIsolationKeyFallback(c.db, "owner/a", []string{"same-cache-key"}, "same-version", "refs/pull/1/head")
+	require.NoError(t, err)
+	require.Equal(t, rows[3].ID, ownPR.ID)
+	base, err := findCacheWithIsolationKeyFallback(c.db, "owner/a", []string{"same-cache-key"}, "same-version", "refs/pull/3/head")
+	require.NoError(t, err)
+	require.Equal(t, rows[1].ID, base.ID)
+}
+
+func TestAvailabilityForeignCacheIDDoesNotTerminateBackend(t *testing.T) {
+	raw, err := newCaches(t.TempDir(), "fixture-secret", logrus.New())
+	require.NoError(t, err)
+	c := raw.(*cachesImpl)
+	defer c.close()
+	row := &Cache{Repo: "owner/private", Key: "private-key", Version: "v1"}
+	require.NoError(t, insertCache(c.db, row))
+	h := &handler{caches: c, logger: logrus.New()}
+	fatalCalls := 0
+	previousFatal := fatal
+	fatal = func(_ logrus.FieldLogger, _ error) { fatalCalls++ }
+	defer func() { fatal = previousFatal }()
+	for _, method := range []string{http.MethodGet, http.MethodPatch, http.MethodPost} {
+		t.Run(method, func(t *testing.T) {
+			request := httptest.NewRequest(method, fmt.Sprintf("http://cache.test/_apis/artifactcache/artifacts/%d", row.ID), nil)
+			request.Header.Set("Forgejo-Cache-Repo", "owner/other")
+			request.Header.Set("Forgejo-Cache-RunNumber", "1")
+			request.Header.Set("Forgejo-Cache-Timestamp", "0")
+			request.Header.Set("Forgejo-Cache-MAC", ComputeMac("fixture-secret", "owner/other", "1", "0", ""))
+			result := httptest.NewRecorder()
+			params := httprouter.Params{{Key: "id", Value: strconv.FormatUint(row.ID, 10)}}
+			switch method {
+			case http.MethodGet:
+				h.get(result, request, params)
+			case http.MethodPatch:
+				h.upload(result, request, params)
+			case http.MethodPost:
+				h.commit(result, request, params)
+			}
+			require.Equal(t, http.StatusNotFound, result.Code)
+			require.Zero(t, fatalCalls, "untrusted cache ID must never stop the shared backend")
+			require.NotContains(t, result.Body.String(), "owner/private")
+			same, err := c.readCache(row.ID, row.Repo)
+			require.NoError(t, err)
+			require.Equal(t, row.ID, same.ID)
+		})
+	}
+}
