#!/bin/sh
set -eu
umask 0077

# The final NixOS system owns this same swapfile declaratively.  Create and
# activate it before the first evaluation so the 1 GiB appliance can build its
# signed configuration without requiring a permanently larger instance.
swap_file=/swapfile
swap_size_bytes=2147483648
current_swap_size="$(stat -c %s "$swap_file" 2>/dev/null || printf 0)"
if [ "$current_swap_size" -ne "$swap_size_bytes" ]; then
  swapoff "$swap_file" 2>/dev/null || true
  dd if=/dev/zero of="$swap_file" bs=1M count=2048 status=none
  chmod 0600 "$swap_file"
  mkswap "$swap_file" >/dev/null
fi
if ! grep -q "^$swap_file"'[[:space:]]' /proc/swaps; then
  swapon "$swap_file"
fi

install -d -m 0750 -o root -g root /etc/stalwart-bootstrap

printf '%s\n' \
  'AWS_REGION=eu-central-1' \
  'STALWART_BUCKET=${bucket_name}' \
  'STALWART_RDS_HOST=${rds_host}' \
  'STALWART_RDS_SECRET_ARN=${rds_secret_arn}' \
  'STALWART_ADMIN_SECRET_ARN=${admin_secret_arn}' \
  'STALWART_MAILBOX_SECRET_ARN=${mailbox_secret_arn}' \
  'STALWART_RESEND_SECRET_ARN=${resend_secret_arn}' \
  > /etc/stalwart-bootstrap/aws.env
chmod 0600 /etc/stalwart-bootstrap/aws.env

source_path="$(
  nix --extra-experimental-features 'nix-command flakes verified-fetches' \
    eval --raw --impure --expr '
      builtins.fetchGit {
        url = "https://github.com/funforgiven/infra.git";
        rev = "${source_revision}";
        verifyCommit = true;
        publicKeys = [{
          type = "ssh-ed25519";
          key = "AAAAC3NzaC1lZDI1NTE5AAAAIL1nHHxNA1YUl+89HhieA+YOyOLYJaSRBmutEOVxVQeB";
        }];
      }
    '
)"

# Build explicitly with the AMI's Nix CLI. Re-executing the newer
# nixos-rebuild frontend on this pinned AMI can use unsupported CLI flags.
# Bound concurrency for the 1 GiB appliance and keep the closure rooted until
# the system profile owns it.
echo 'Building the verified mail appliance configuration.'
system_path="$(
  nix --extra-experimental-features 'nix-command flakes verified-fetches' build \
    --max-jobs 1 --cores 1 \
    --out-link /root/stalwart-bootstrap-system --print-out-paths \
    "$source_path#nixosConfigurations.mail-aws.config.system.build.toplevel"
)"
nix-env --profile /nix/var/nix/profiles/system --set "$system_path"
rm -f /root/stalwart-bootstrap-system
echo 'Activating the verified mail appliance configuration.'
exec "$system_path/bin/switch-to-configuration" switch
