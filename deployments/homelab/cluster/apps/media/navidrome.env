# Non-secret Navidrome settings shared by the server and its CLI init containers.
ND_AGENTS=audiomuseai,lastfm,listenbrainz,deezer
ND_BACKUP_COUNT=7
ND_BACKUP_PATH=/data/backups
ND_BACKUP_SCHEDULE=0 3 * * *
ND_DATAFOLDER=/data
ND_DEFAULTLANGUAGE=en
ND_ENABLEINSIGHTSCOLLECTOR=false
ND_ENABLELOGREDACTING=true
ND_ENABLESHARING=false
ND_EXTAUTH_LOGOUTURL=https://music.fahrican.com/oauth2/sign_out
ND_EXTAUTH_TRUSTEDSOURCES=127.0.0.1/32,::1/128
ND_EXTAUTH_USERHEADER=X-Forwarded-Preferred-Username
ND_LASTFM_LANGUAGE=en
ND_LOGLEVEL=info
ND_LYRICSPRIORITY=embedded,.lrc,.elrc,.ttml,.srt,.txt,nd-lyrics
ND_MUSICFOLDER=/music
ND_PLUGINS_AUTORELOAD=true
ND_PLUGINS_ENABLED=true
ND_PLUGINS_FOLDER=/data/plugins
ND_PROMETHEUS_ENABLED=true
ND_SCANNER_SCHEDULE=@every 1m
ND_SEARCH_BACKEND=fts
