# The Dongle-M must run Thread RCP firmware and Ethernet socket mode.
NETWORK_DEVICE=10.21.50.21:6638
DEVICE=/tmp/ttyOTBR
BAUDRATE=115200
FLOW_CONTROL=0
BACKBONE_IF=net1
FIREWALL=1
NAT64=0
AUTOFLASH_FIRMWARE=0
OTBR_LOG_LEVEL=notice
OTBR_REST_PORT=8081
OTBR_WEB=0
OTBR_WEB_PORT=7586
TZ=Europe/Istanbul
